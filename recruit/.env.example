# Backend Spring Boot sample env.
# Copy to .env on your machine or VPS and fill real values.

DB_URL=jdbc:mysql://localhost:3306/recruit?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=change-me

APP_PUBLIC_BASE_URL=http://localhost:8080
APP_FRONTEND_BASE_URL=http://localhost:3000

APP_EMBEDDING_PYTHON_URL=http://localhost:8001

APP_QDRANT_ENABLED=true
APP_QDRANT_URL=http://localhost:6333
APP_QDRANT_API_KEY=
APP_QDRANT_TIMEOUT_MILLIS=10000

APP_ELASTICSEARCH_ENABLED=true
APP_ELASTICSEARCH_URL=http://localhost:9200
APP_ELASTICSEARCH_API_KEY=
APP_ELASTICSEARCH_USERNAME=
APP_ELASTICSEARCH_PASSWORD=
APP_ELASTICSEARCH_TIMEOUT_MILLIS=10000

