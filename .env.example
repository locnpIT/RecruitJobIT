# Root compose/env sample for VPS or local Docker Compose.
# Copy to .env.vps (or keep as-is for reference) and fill real values on server.

DB_URL=jdbc:mysql://mysql:3306/recruit?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=change-me
SECRET_KEY_JWT=change-me

APP_CLOUDINARY_CLOUD_NAME=change-me
APP_CLOUDINARY_API_KEY=change-me
APP_CLOUDINARY_API_SECRET=change-me
APP_CLOUDINARY_FOLDER=recruit/proofs

APP_PUBLIC_BASE_URL=http://YOUR_VPS_IP:8080
APP_FRONTEND_BASE_URL=http://YOUR_VPS_IP:3000
APP_EMBEDDING_PYTHON_URL=http://embedding-api:8001

APP_QDRANT_ENABLED=true
APP_QDRANT_URL=http://qdrant:6333
APP_QDRANT_API_KEY=
APP_QDRANT_TIMEOUT_MILLIS=10000

APP_ELASTICSEARCH_ENABLED=true
APP_ELASTICSEARCH_URL=http://elasticsearch:9200
APP_ELASTICSEARCH_API_KEY=
APP_ELASTICSEARCH_USERNAME=
APP_ELASTICSEARCH_PASSWORD=
APP_ELASTICSEARCH_TIMEOUT_MILLIS=10000

APP_GEMINI_ENABLED=true
APP_GEMINI_API_KEY=change-me
APP_GEMINI_MODEL_NAME=gemini-2.5-flash

APP_MAIL_ENABLED=true
APP_MAIL_FROM_EMAIL=change-me@example.com
APP_MAIL_FROM_NAME=Recruit
SPRING_MAIL_USERNAME=change-me@example.com
SPRING_MAIL_PASSWORD=change-me
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=5000

APP_SEPAY_MERCHANT_ID=change-me
APP_SEPAY_MERCHANT_SECRET_KEY=change-me
APP_SEPAY_BANK_SHORT_NAME=change-me
APP_SEPAY_BANK_ACCOUNT_NUMBER=change-me
APP_SEPAY_PAYMENT_CODE_PREFIX=GOI
APP_SEPAY_WEBHOOK_SECRET_KEY=change-me
APP_SEPAY_WEBHOOK_URL=http://YOUR_VPS_IP:8080/api/v1/sepay/webhook
APP_SEPAY_QR_IMAGE_BASE_URL=https://qr.sepay.vn/img
APP_SEPAY_CHECKOUT_INIT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
APP_SEPAY_CHECKOUT_CURRENCY=VND
APP_SEPAY_CHECKOUT_OPERATION=PURCHASE
APP_SEPAY_CHECKOUT_SUCCESS_URL=http://YOUR_VPS_IP:3000/company-admin/packages/success
APP_SEPAY_CHECKOUT_ERROR_URL=http://YOUR_VPS_IP:3000/company-admin/packages/error
APP_SEPAY_CHECKOUT_CANCEL_URL=http://YOUR_VPS_IP:3000/company-admin/packages/cancel
APP_SEPAY_CHECKOUT_PAYMENT_METHOD=

NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:8080/api/v1
API_INTERNAL_URL=http://backend:8080/api/v1
