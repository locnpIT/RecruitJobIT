# Root compose/env sample for VPS or local Docker Compose.
# Copy to .env.vps (or keep as-is for reference) and fill real values on server.

DB_URL=jdbc:mysql://mysql:3306/recruit?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=change-me

APP_PUBLIC_BASE_URL=http://YOUR_VPS_IP:8080
APP_FRONTEND_BASE_URL=http://YOUR_VPS_IP:3000
APP_EMBEDDING_PYTHON_URL=http://embedding-api:8001

APP_QDRANT_ENABLED=true
APP_QDRANT_URL=http://qdrant:6333
APP_QDRANT_API_KEY=
APP_QDRANT_TIMEOUT_MILLIS=10000

APP_ELASTICSEARCH_ENABLED=true
APP_ELASTICSEARCH_URL=http://elasticsearch:9200
APP_ELASTICSEARCH_API_KEY=
APP_ELASTICSEARCH_USERNAME=
APP_ELASTICSEARCH_PASSWORD=
APP_ELASTICSEARCH_TIMEOUT_MILLIS=10000

NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:8080/api/v1
API_INTERNAL_URL=http://backend:8080/api/v1

